# Token da API do Apify (Console Apify → Settings → API & Integrations).
# NUNCA exponha este valor no frontend nem faça commit dele.
APIFY_API_TOKEN=

# Actor usado na busca. Padrão recomendado: compass/crawler-google-places (Google Maps Scraper).
# Aceita "usuario/nome-do-actor", "usuario~nome-do-actor" ou o ID interno do Actor.
APIFY_ACTOR_ID=

# --- Opcionais ---
# Limite máximo de leads por busca (protege contra custos inesperados). Padrão: 100
# APIFY_MAX_LEADS=100
# Idioma dos resultados do Google Maps. Padrão: pt-BR
# APIFY_LANGUAGE=pt-BR
# Tempo máximo de execução do Actor, em segundos. Padrão: 600
# APIFY_RUN_TIMEOUT_SECS=600
# Teto de gasto por execução (USD) para Actors cobrados por evento. Vazio = sem teto extra.
# APIFY_MAX_CHARGE_USD=1
# JSON mesclado ao input padrão do Actor (para ajustar parâmetros sem mexer no código).
# APIFY_ACTOR_INPUT_JSON={"scrapeContacts":false}
# Força o modo demonstração mesmo com token configurado (true/false).
# NEXALEADS_DEMO_MODE=false
